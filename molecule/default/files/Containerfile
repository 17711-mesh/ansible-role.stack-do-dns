FROM python:3.11-slim

ARG PY_COMPOSE_TO_QUADLET_REF=v0.1.0
ARG ANSIBLE_ROLE_COMPOSE_TO_QUADLET_REF=v0.1.0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        systemd \
        ssh && \
    rm -rf /var/lib/apt/lists/*

# Prepare Ansible remote tmp in test user home
RUN mkdir -p /home/${TEST_USER}/.ansible/tmp && \
    chown -R ${TEST_USER}:${TEST_GID} /home/${TEST_USER}/.ansible  

# Install Ansible
RUN pip install --no-cache-dir ansible

# Install python.compose-to-quadlet from GitHub
RUN pip install --no-cache-dir \
    "git+https://github.com/17711-mesh/python.compose-to-quadlet.git@${PY_COMPOSE_TO_QUADLET_REF}"

# Install the dependent role from GitHub via ansible-galaxy
RUN ansible-galaxy role install \
      "git+https://github.com/17711-mesh/ansible-role.compose-to-quadlet.git,${ANSIBLE_ROLE_COMPOSE_TO_QUADLET_REF}" \
      -p /etc/ansible/roles

ENV ANSIBLE_ROLES_PATH=/etc/ansible/roles

WORKDIR /work

CMD ["sleep", "infinity"]